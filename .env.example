# Burnrate environment. Copy to .env (never committed). On the server, setup.sh copies it
# to /opt/burnrate/.env, owned root:burnrate, mode 640, and the poller reads it itself (the
# systemd unit has no EnvironmentFile). One KEY=value per line and no comment after a value:
# read_env_file keeps the comment as part of the value.

# Read-only token the Mac app sends. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BURNRATE_TOKEN=
# Discord: channel settings, Integrations, Webhooks, New Webhook, Copy Webhook URL
DISCORD_WEBHOOK_URL=
# Neon: account settings, API keys. Prefer a project-scoped key if your plan offers one.
NEON_API_KEY=
# Clerk: dashboard, API keys, Secret key
CLERK_SECRET_KEY=
# Vercel: account settings, Tokens. Scope it to your account and give it an expiry.
VERCEL_TOKEN=
# Only if your projects live under a Vercel team
VERCEL_TEAM_ID=
